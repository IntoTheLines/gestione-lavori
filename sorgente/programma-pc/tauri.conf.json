{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestione Lavori",
  "version": "1.4.0",
  "identifier": "it.jacopo.gestionelavori",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Gestione Lavori",
        "width": 1300,
        "height": 850,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}